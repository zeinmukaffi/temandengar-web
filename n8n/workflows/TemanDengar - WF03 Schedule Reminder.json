        "toEmail": "={{ $json.data.recipient_email }}",
        "subject": "={{\n    $json.data.reminder_type === '24h'\n    ? '[TemanDengar] Pengingat Konsultasi Besok'\n    : '[TemanDengar] Pengingat Konsultasi 1 Jam Lagi'\n}}",
        "emailFormat": "text",
        "text": "=\n{{\n'Halo ' + $json.data.recipient_name + ',\\n\\n' +\n\n(\n    $json.data.reminder_type === '24h'\n    ? 'Ini adalah pengingat bahwa jadwal konsultasimu akan berlangsung sekitar 24 jam lagi.'\n    : 'Ini adalah pengingat bahwa jadwal konsultasimu akan berlangsung sekitar 1 jam lagi.'\n) +\n\n'\\n\\nDETAIL KONSULTASI\\n\\n' +\n\n'Nomor Tiket: ' + $json.data.ticket_number + '\\n' +\n'Mahasiswa: ' + $json.data.student_name + '\\n' +\n'Konselor: ' + $json.data.counselor_name + '\\n' +\n'Tanggal dan Waktu: ' + $json.data.scheduled_at_label + '\\n' +\n'Metode: ' + $json.data.method_label + '\\n\\n' +\n\n(\n    $json.data.method === 'online'\n    ? 'Link Google Meet: ' +\n        ($json.data.meeting_link || 'Silakan periksa dashboard TemanDengar.') + '\\n'\n    : 'Lokasi: ' +\n        ($json.data.location || 'Silakan konfirmasi kepada konselor.') + '\\n'\n) +\n\n'\\nMohon pastikan kamu memperhatikan jadwal konsultasi tersebut.\\n\\n' +\n'Terima kasih.\\n\\n' +\n'TemanDengar Team\\n' +\n'Ruang aman untuk didengar, teman untuk bercerita.'\n}}\n",
